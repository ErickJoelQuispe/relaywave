apiVersion: v1
kind: Secret
metadata:
    name: backend-secrets
    namespace: relaywave
type: Opaque
stringData:
    DATABASE_URL: 'postgresql+asyncpg://relaywave:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/relaywave'
    REDIS_URL: 'redis://redis:6379/0'
    JWT_SECRET_KEY: 'REPLACE_WITH_RANDOM_HEX_SECRET'
