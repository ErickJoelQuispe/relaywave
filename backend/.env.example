APP_NAME=relaywave-backend
ENVIRONMENT=local
DEBUG=true

# Host-side URL for running the API locally with `uv run uvicorn --reload`.
# Points at the Postgres exposed on 127.0.0.1:5432 by docker-compose.
# Use the same password as POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgresql+asyncpg://relaywave:CHANGE_ME@localhost:5432/relaywave

# Auth (JWT) — required. Generate with `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
