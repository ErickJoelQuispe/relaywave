# Root-level env vars used by docker-compose.yml.
#
# Phase 1: Postgres is now exposed on 127.0.0.1:5432 so the API can run
# locally (`uv run uvicorn --reload`) against the same database the
# containers use. Because Postgres is host-reachable, set a real
# POSTGRES_PASSWORD below (copy this file to .env and replace CHANGE_ME)
# instead of the old relaywave/relaywave dev default.
#
# The api service's DATABASE_URL is assembled by compose from the
# POSTGRES_* values here; you do not need to set it separately.

POSTGRES_USER=relaywave
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=relaywave

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
