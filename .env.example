# Root-level env vars used by docker-compose.yml.
#
# Phase 0 note: the FastAPI app does not read these yet — it has no
# database or cache client wired in. They are defined here so the
# Postgres/Redis connection details are documented ahead of the
# SQLAlchemy/Alembic/redis-py wiring added in a later phase (see
# docs/project-definition.md).
#
# Values below are dev-only placeholders, not real credentials.

POSTGRES_USER=relaywave
POSTGRES_PASSWORD=relaywave
POSTGRES_DB=relaywave
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://relaywave:relaywave@postgres:5432/relaywave

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
